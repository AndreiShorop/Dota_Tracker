APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5433/dota_tracker
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dota_tracker

# OpenDota API
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_TIMEOUT_SECONDS=30
OPENDOTA_MAX_RETRIES=3
OPENDOTA_RATE_LIMIT_RPM=60
